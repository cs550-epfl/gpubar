  st.release.sys R0C0, 0   | st.release.sys R1C0, 0  |                         |                         | st.release.sys R0C1, 0  | st.release.sys R1C1, 0  |                         |                         ; 
  LC00:                    | LC10:                   | LC20:                   | LC30:                   | LC40:                   | LC50:                   | LC60:                   | LC70:                   ; 
  ld.acquire.sys r0, R0C0  | ld.acquire.sys r0, R0C1 | ld.acquire.sys r0, R0C0 | ld.acquire.sys r0, R0C1 | ld.acquire.sys r0, R1C0 | ld.acquire.sys r0, R1C1 | ld.acquire.sys r0, R1C0 | ld.acquire.sys r0, R1C1 ; 
  bne r0, 0, LC00          | bne r0, 0, LC10         | bne r0, 0, LC20         | bne r0, 0, LC30         | bne r0, 0, LC40         | bne r0, 0, LC50         | bne r0, 0, LC60         | bne r0, 0, LC70         ; 
  bar.cta.sync 0           | bar.cta.sync 0          | bar.cta.sync 0          | bar.cta.sync 0          | bar.cta.sync 0          | bar.cta.sync 0          | bar.cta.sync 0          | bar.cta.sync 0          ; 
                           | ld.weak r1, x           | ld.weak r1, x           | ld.weak r1, x           | ld.weak r1, x           | ld.weak r1, x           | ld.weak r1, x           | ld.weak r1, x           ;
forall
